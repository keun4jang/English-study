{
  "expo": {
    "name": "D-log",
    "slug": "d-log",
    "version": "0.7.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dlog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "음성으로 일기를 작성할 때 마이크를 사용해요.",
        "NSSpeechRecognitionUsageDescription": "말한 내용을 텍스트로 변환할 때 사용해요.",
        "NSPhotoLibraryUsageDescription": "일기에 사진을 추가할 때 사용해요."
      }
    },
    "android": {
      "package": "com.dlog.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#D8A233",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "D-log",
      "shortName": "D-log",
      "themeColor": "#E0A82E",
      "backgroundColor": "#FFFBF3",
      "description": "말한 하루가 외국어 일기가 되는 데일리 로그"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFBF3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
