{
  "expo": {
    "name": "Mellow Diary",
    "slug": "mellow-diary",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mellowdiary",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "음성으로 일기를 작성할 때 마이크를 사용해요.",
        "NSSpeechRecognitionUsageDescription": "말한 내용을 텍스트로 변환할 때 사용해요.",
        "NSPhotoLibraryUsageDescription": "일기에 사진을 추가할 때 사용해요."
      }
    },
    "android": {
      "package": "com.mellowdiary.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFF9F5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Mellow Diary",
      "shortName": "Mellow",
      "themeColor": "#9B8AC4",
      "backgroundColor": "#FFF9F5",
      "description": "AI 친구와 대화하며 완성하는 외국어 일기"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF9F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
