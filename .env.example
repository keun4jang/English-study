# ==========================================================
# Mellow Diary 환경변수 예시
# 실제 값은 .env에 넣고, .env는 절대 Git에 커밋하지 마세요.
# EXPO_PUBLIC_ 접두사가 붙은 값만 클라이언트(앱)에 노출됩니다.
# ==========================================================

# 앱 환경: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# ---------- Supabase (Phase 2에서 연결) ----------
# 없으면 앱은 Demo/Mock 모드로 동작합니다.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ SUPABASE_SERVICE_ROLE_KEY는 **서버 전용**입니다.
# 절대 앱(.env의 EXPO_PUBLIC_*)에 넣지 마세요.
# Supabase Edge Function Secrets에만 설정합니다:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...

# ---------- AI (Anthropic) ----------
# ⚠️ ANTHROPIC_API_KEY는 **서버 전용**입니다. 클라이언트에 절대 넣지 마세요.
# Edge Function Secrets에만 설정합니다:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set AI_ENABLED=true

# 클라이언트에서 실제 AI(서버 경유)를 사용할지 여부.
# false면 Mock AI Provider가 사용됩니다 (비용 0원).
EXPO_PUBLIC_AI_ENABLED=false

# ---------- 사용량/비용 보호 (클라이언트 UX용 — 서버에서도 재검증됨) ----------
EXPO_PUBLIC_DAILY_AI_TURN_LIMIT=20
EXPO_PUBLIC_DAILY_DIARY_GENERATION_LIMIT=3
EXPO_PUBLIC_MAX_AI_INPUT_CHARACTERS=2000
EXPO_PUBLIC_MAX_DIARY_CHARACTERS=20000
EXPO_PUBLIC_MAX_PHOTOS_PER_DIARY=3
EXPO_PUBLIC_MAX_PHOTO_BYTES=1000000
